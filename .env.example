# Jeton du bot Telegram (via @BotFather)
TELEGRAM_BOT_TOKEN=

# === MOTEUR IA ==============================================================
# LLM_PROVIDER : "claude" (API, qualité + fiabilité), "mlx"/"ollama" (local
# gratuit), "none" (questionnaire guidé), ou vide = auto-détection.
LLM_PROVIDER=claude

# --- Option A (recommandée) : Claude (API Anthropic) ---
# Clé sur https://platform.claude.com/settings/keys (créditer ~5-10$).
ANTHROPIC_API_KEY=
# Modèle : claude-haiku-4-5 = le moins cher (conseillé pour démarrer) ;
#          claude-sonnet-5 = meilleure qualité ; claude-opus-4-8 = maximum.
CLAUDE_MODEL=claude-haiku-4-5

# --- Option B : MLX local (Qwen3, Apple Silicon, gratuit) ---
# Mettre LLM_PROVIDER=mlx ci-dessus. pip install -r requirements-mlx.txt
MLX_MODEL=mlx-community/Qwen3-4B-4bit
MLX_MAX_TOKENS=400
MLX_THINK=false
MLX_TEMP=0.7
MLX_REPETITION_PENALTY=1.15

# --- Option C : Ollama local ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_NUM_CTX=8192
OLLAMA_THINK=false
OLLAMA_KEEP_ALIVE=30m

# RAG (mémoire déportée hors du prompt) — actif pour mlx/ollama : auto/true/false
RAG_ENABLED=auto
RAG_TOP_K=5

# Chemin de la base de données (partagée entre le bot et le dashboard)
DATABASE_URL=sqlite:///data/app.db

# Mot de passe du tableau de bord administrateur
ADMIN_PASSWORD=changez-moi

# Administration PAR TELEGRAM (depuis votre smartphone) : votre ID Telegram
# (obtenez-le en envoyant /monid au bot), plusieurs IDs séparés par des virgules.
# Donne accès aux commandes /admin, /membres, /fiche, /matchs, /conv, /publier.
ADMIN_TELEGRAM_IDS=

# (Optionnel) ID du groupe Telegram pour l'animation communautaire
# Ex: -1001234567890
COMMUNITY_CHAT_ID=

# Journal des conversations pour étudier le comportement du modèle
# (fichier local data/conversation_log.jsonl ; consultable via /journal sur Telegram).
CONVERSATION_LOG=true

# RGPD : exiger le consentement au /start avant toute conversation.
CONSENT_REQUIRED=true

# Plafond d'appels IA par membre et par jour (maîtrise des coûts + anti-flood).
MAX_MESSAGES_PER_DAY=40

# Seuil de compatibilité (0-100) au-delà duquel une suggestion est envoyée
MATCH_THRESHOLD=65

# Complétude minimale (0-100) d'un profil pour entrer dans le matching
MIN_COMPLETENESS_FOR_MATCHING=30

# Pondérations du matching (ajustables ; la somme fait 100). Les critères
# recherchés explicites ajoutent un bonus/malus par-dessus.
MATCH_W_RELIGION=25
MATCH_W_FAMILY=20
MATCH_W_LOCATION=15
MATCH_W_PERSONALITY=10
MATCH_W_INTERESTS=18
MATCH_W_LIFESTYLE=7
MATCH_W_AGE=5
