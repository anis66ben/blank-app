# Jeton du bot Telegram (via @BotFather)
TELEGRAM_BOT_TOKEN=

# === MOTEUR IA ==============================================================
# LLM_PROVIDER : "ollama" (local, gratuit), "claude" (API payante), "none"
# (questionnaire guidé), ou vide = auto-détection.
LLM_PROVIDER=ollama

# --- Option A : Ollama local (Qwen3 8B) — gratuit et privé ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
# Modèle d'embeddings pour le RAG (à installer : ollama pull nomic-embed-text)
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_NUM_CTX=8192
# Raisonnement Qwen3 : false = beaucoup plus rapide (recommandé). true = plus fin mais lent.
OLLAMA_THINK=false
# Garde le modèle chargé en mémoire (évite un rechargement lent à chaque message).
OLLAMA_KEEP_ALIVE=30m

# RAG (mémoire vectorielle, "fenêtre de contexte déportée") : auto/true/false
RAG_ENABLED=auto
RAG_TOP_K=5

# --- Option B : Claude (API Anthropic, payante) — laisser vide si Ollama ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-4-8

# Chemin de la base de données (partagée entre le bot et le dashboard)
DATABASE_URL=sqlite:///data/app.db

# Mot de passe du tableau de bord administrateur
ADMIN_PASSWORD=changez-moi

# Administration PAR TELEGRAM (depuis votre smartphone) : votre ID Telegram
# (obtenez-le en envoyant /monid au bot), plusieurs IDs séparés par des virgules.
# Donne accès aux commandes /admin, /membres, /fiche, /matchs, /conv, /publier.
ADMIN_TELEGRAM_IDS=

# (Optionnel) ID du groupe Telegram pour l'animation communautaire
# Ex: -1001234567890
COMMUNITY_CHAT_ID=

# Seuil de compatibilité (0-100) au-delà duquel une suggestion est envoyée
MATCH_THRESHOLD=65

# Complétude minimale (0-100) d'un profil pour entrer dans le matching
MIN_COMPLETENESS_FOR_MATCHING=30
